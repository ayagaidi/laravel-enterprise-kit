{
  "name": "ayagaidi/laravel-enterprise-kit",
  "type": "project",
  "description": "Production-minded Laravel 13 starter for enterprise applications with RBAC, audit trails, settings, localization, APIs, testing and CI.",
  "keywords": ["laravel", "enterprise", "rbac", "audit-log", "api", "sanctum", "arabic", "rtl", "starter-kit"],
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.17",
    "laravel/sanctum": "^4.3"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.27",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {"psr-4": {"App\\": "app/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/", "Database\\Seeders\\": "database/seeders/"}},
  "scripts": {
    "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
    "post-create-project-cmd": ["@php artisan key:generate --ansi"],
    "test": "@php artisan test",
    "lint": "pint --test"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
